{
  "name": "blt-twitch-extension",
  "private": true,
  "version": "0.0.8",
  "type": "module",
  "scripts": {
    "sync:manifest": "node scripts/sync-manifest.mjs",
    "dev": "npm run sync:manifest && vite --host 127.0.0.1",
    "build": "npm run sync:manifest && tsc -b && vite build && node scripts/copy-entry-pages.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:packaging": "node --test scripts/verify-package.check.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
